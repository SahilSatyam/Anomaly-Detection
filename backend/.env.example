# Database Configuration
# Copy this file to .env and fill in your actual credentials
# NEVER commit the .env file to version control!

# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://username:password@localhost:5432/stock_db

# Optional: Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Optional: API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Optional: CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ============== Alert System Configuration ==============

# Email Alerts (using SMTP)
ALERT_EMAIL_ENABLED=false
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
ALERT_EMAIL_SENDER=your-email@gmail.com
ALERT_EMAIL_PASSWORD=your-app-password
ALERT_EMAIL_RECIPIENTS=recipient1@example.com,recipient2@example.com

# Slack Webhook
# Get your webhook URL from: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=

# Discord Webhook
# Get your webhook URL from Discord channel settings -> Integrations -> Webhooks
DISCORD_WEBHOOK_URL=

# Custom Webhook (receives JSON payloads)
CUSTOM_WEBHOOK_URL=

# Alert Thresholds
ALERT_MIN_SCORE=1.5
ALERT_BATCH=true

# ============== Model Cache Configuration ==============

# Maximum age of cached models in hours before retraining
MODEL_MAX_AGE_HOURS=24

# Directory for storing cached models (relative to backend folder)
MODEL_CACHE_DIR=./models
